# ─── Supabase ────────────────────────────────────────────────────────────────
# Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — never expose to the browser, never prefix NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Google OAuth ────────────────────────────────────────────────────────────
# Same client ID/secret you paste into Supabase → Authentication → Providers → Google.
# The cron job needs them here too, to refresh access tokens on its own.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Site ────────────────────────────────────────────────────────────────────
# Public origin, no trailing slash. Used for OAuth redirects and push links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Only these email addresses may sign in (comma-separated). Leave empty to allow
# anyone with a Google account — not what you want for a personal app.
ALLOWED_EMAILS=kaigotlib@gmail.com

# ─── Cron ────────────────────────────────────────────────────────────────────
# Vercel sends this automatically as `Authorization: Bearer $CRON_SECRET`.
# Set it in Vercel project settings; any long random string works.
CRON_SECRET=

# ─── Web Push (VAPID) ────────────────────────────────────────────────────────
# Generate with: npm run vapid
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:kaigotlib@gmail.com
